<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- E2 (SETUP_UI_DECISIONS.md): INTERNET + ACCESS_NETWORK_STATE stay permanently
         in the manifest — the only network access is the one-time model download
         (the ORT AAR inserts both anyway). The app-internal network switch prevents
         requests after setup; the telemetry provider removal (below) STAYS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Audio capture (stage 4): RECORD_AUDIO for the recording,
         FOREGROUND_SERVICE(_MICROPHONE) for the FGS type microphone
         (TECH_FACTS §4.1: hard requirement from targetSdk 34),
         POST_NOTIFICATIONS for the visible recording indication (API 33+). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- E1: dataSync FGS for the 671 MB model download (6 h/24 h limit,
         onTimeout handled in the service). Model download only, no other transfer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:label="Voice Keyboard"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.VoiceKeyboard"
        android:allowBackup="false">

        <!-- SB1-07: remove the ORT AAR telemetry provider via manifest merger
             (TECH_FACTS.md §3 concept 3) — must be a child of <application>. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            tools:node="remove" />

        <activity
            android:name=".ime.SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ime.VoiceKeyboardService"
            android:exported="true"
            android:label="Voice Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <service
            android:name=".capture.CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".model.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
