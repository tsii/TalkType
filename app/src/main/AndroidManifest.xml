<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- T20 (PLAN_V0145, binding clarification): INTERNET stays in the manifest —
         the ONLY network access is the one-time model download. The app never
         revokes or touches the network itself; the user can revoke the network
         permission at the SYSTEM level (app info) — the app then stays offline.
         ACCESS_NETWORK_STATE is still merged in from the onnxruntime AAR; our
         code never uses it — left in place (tools:node remove rejected as noise).
         The telemetry provider removal (below) STAYS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Audio capture (stage 4): RECORD_AUDIO for the recording,
         FOREGROUND_SERVICE(_MICROPHONE) for the FGS type microphone
         (TECH_FACTS §4.1: hard requirement from targetSdk 34).
         T21b (PLAN_V0145, measurement 2026-11-04): POST_NOTIFICATIONS is
         OPTIONAL — download-progress UX + recording notice; the OS does NOT
         stop the FGS mic without it (api36 field evidence), so it never gates
         the dictation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- E1: dataSync FGS for the 671 MB model download (6 h/24 h limit,
         onTimeout handled in the service). Model download only, no other transfer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.VoiceKeyboard"
        android:allowBackup="false">

        <!-- SB1-07: remove the ORT AAR telemetry provider via manifest merger
             (TECH_FACTS.md §3 concept 3) — must be a child of <application>. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            tools:node="remove" />

        <activity
            android:name=".ime.SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ime.VoiceKeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <service
            android:name=".capture.CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".model.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
