<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="13sp" />

        <TextView
            android:id="@+id/setup_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_state_absent"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/setup_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setup_file_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/setup_download_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_download_start" />

        <Button
            android:id="@+id/setup_download_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_download_cancel"
            android:visibility="gone" />

        <!-- T20b (PLAN_V0145): one-time system-level network-revoke invite.
             The app NEVER revokes/touches the network itself; the card offers
             the direct app-details deep link. Visibility is set in code
             (NetworkInvitePolicy.shouldShowInvite). -->
        <LinearLayout
            android:id="@+id/setup_net_invite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/setup_net_invite_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_net_invite_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setup_net_invite_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_net_invite_body"
                android:textSize="13sp" />

            <Button
                android:id="@+id/setup_net_invite_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_net_invite_button" />

            <Button
                android:id="@+id/setup_net_invite_later"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_net_invite_later" />
        </LinearLayout>
        <Button
            android:id="@+id/setup_request_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_request_permissions" />

        <TextView
            android:id="@+id/setup_permissions_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_permissions_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/setup_open_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_open_settings"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setup_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_privacy_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
